@model List<TutorRating>
@{ ViewData["Title"] = "Tutor ratings"; var summary = (List<TutorRatingRow>)ViewBag.Summary; }
<header class="page-head"><h1>Tutor ratings</h1><p class="page-sub">Monthly ratings from parents. The recent average covers the last 3 months.</p></header>

<section class="section">
    <h2>Averages</h2>
    @if (summary.Count == 0) { <p class="empty-note"><i class="bi bi-star" aria-hidden="true"></i> No ratings yet.</p> }
    else
    {
        <div class="table-card table-responsive"><table class="table align-middle">
            <thead><tr><th>Tutor</th><th>Recent average</th><th>All-time average</th><th>Ratings</th></tr></thead>
            <tbody>
            @foreach (var r in summary)
            {
                <tr><td><a asp-controller="Tutors" asp-action="Details" asp-route-id="@r.Tutor.Id">@r.Tutor.FullName</a></td>
                    <td>@(r.AverageRecent == 0 ? "-" : r.AverageRecent.ToString("0.0") + " / 5")</td><td>@r.AverageAll.ToString("0.0") / 5</td><td>@r.Count</td></tr>
            }
            </tbody>
        </table></div>
    }
</section>

<section class="section">
    <h2>Recent ratings</h2>
    <div class="panel"><ul class="list-plain">
        @foreach (var r in Model)
        {
            <li class="d-block">
                <div class="d-flex justify-content-between flex-wrap gap-1"><span><strong>@r.Tutor?.FullName</strong> · @(new string('★', r.Stars))@(new string('☆', 5 - r.Stars))</span><span class="muted small">@Fmt.Month(r.Year, r.Month) · from the parent of @r.Student?.FullName</span></div>
                @if (!string.IsNullOrWhiteSpace(r.Comment)) { <div class="muted" style="white-space:pre-line">@r.Comment</div> }
            </li>
        }
        @if (Model.Count == 0) { <li class="muted">Nothing yet.</li> }
    </ul></div>
</section>
<partial name="_Pager" model="(PageInfo)ViewBag.PageInfo" />
