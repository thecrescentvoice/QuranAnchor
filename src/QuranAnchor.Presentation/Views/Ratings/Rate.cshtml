@model RatingFormViewModel
@{ ViewData["Title"] = "Rate my tutor"; }
<header class="page-head"><h1>Rate my tutor</h1><p class="page-sub">Once a month, tell us how the classes are going. It helps the academy look after your child's learning.</p></header>

@if (!Model.HasTutor)
{
    <p class="empty-note"><i class="bi bi-person-x" aria-hidden="true"></i> No tutor is assigned yet.</p>
}
else
{
    <form asp-action="Rate" method="post" class="panel" style="max-width:640px">
        <p class="mb-1">Tutor: <strong>@Model.TutorName</strong></p>
        <p class="muted">For @Fmt.Month(Model.Year, Model.Month)@(Model.AlreadyRated ? ". You already rated this month; you can change it." : ".")</p>
        <div class="star-input" role="radiogroup" aria-label="Rating from 1 to 5 stars">
            @for (var i = 5; i >= 1; i--)
            {
                <input type="radio" id="star@(i)" name="stars" value="@i" checked="@(Model.Stars == i)" required /><label for="star@(i)" title="@i stars"><i class="bi bi-star-fill" aria-hidden="true"></i><span class="visually-hidden">@i stars</span></label>
            }
        </div>
        <div class="mt-3 mb-3"><label class="form-label" for="comment">Comment (optional)</label>
            <textarea id="comment" name="comment" class="form-control" rows="4" maxlength="1000" placeholder="What is going well? What could be better?">@Model.Comment</textarea></div>
        <button class="btn btn-primary btn-lg" type="submit">Save my rating</button>
        <p class="form-text mt-2 mb-0">Your comment is seen only by the supervisor and the admins. Your tutor sees just an average score, never who gave it.</p>
    </form>
}
