@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Check your email";
}

<h1 class="auth-title">Check your email</h1>
<p class="auth-sub">If an account matches what you entered, a reset link is on its way. The link works once and expires in one hour. Look in your spam folder if you do not see it.</p>

<div class="auth-links">
    <a asp-action="Login">Back to sign in</a>
</div>
