@model LoginViewModel
@inject QuranAnchor.Application.Abstractions.ISettingsService Settings
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Sign in";
    var b = await Settings.GetBrandingAsync();
    var helpLink = string.IsNullOrEmpty(b.SupervisorWhatsApp)
        ? null
        : $"https://wa.me/{b.SupervisorWhatsApp}?text={Uri.EscapeDataString("Assalamu alaikum, I need help signing in to the portal.")}";
}

<h1 class="auth-title">Sign in</h1>
<p class="auth-sub">Students and parents use the Student ID. Staff use their email.</p>

<form asp-action="Login" method="post" novalidate>
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="Identifier" class="form-label"></label>
        <input asp-for="Identifier" class="form-control form-control-lg" autocomplete="username" autocapitalize="off" spellcheck="false" autofocus />
        <span asp-validation-for="Identifier" class="field-error"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Password" class="form-label"></label>
        <div class="input-group">
            <input asp-for="Password" class="form-control form-control-lg" autocomplete="current-password" />
            <button class="btn btn-outline-secondary" type="button" data-toggle-password aria-label="Show password">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Sign in</button>
</form>

<div class="auth-links">
    <a asp-action="ForgotPassword">Forgot your password?</a>
    @if (helpLink is not null)
    {
        <a href="@helpLink" target="_blank" rel="noopener">Need help? Message the supervisor</a>
    }
</div>
