@model ChangePasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change password";
}

<h1 class="auth-title">@(Model.IsForced ? "Choose your own password" : "Change password")</h1>
<p class="auth-sub">
    @if (Model.IsForced)
    {
        <text>You are using a temporary password. Choose your own before you continue.</text>
    }
    else
    {
        <text>Use at least 8 characters, with a number.</text>
    }
</p>

<form asp-action="ChangePassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-3">
        <label asp-for="CurrentPassword" class="form-label"></label>
        <input asp-for="CurrentPassword" class="form-control form-control-lg" autocomplete="current-password" autofocus />
        <span asp-validation-for="CurrentPassword" class="field-error"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NewPassword" class="form-label"></label>
        <div class="input-group">
            <input asp-for="NewPassword" class="form-control form-control-lg" autocomplete="new-password" />
            <button class="btn btn-outline-secondary" type="button" data-toggle-password aria-label="Show password">
                <i class="bi bi-eye" aria-hidden="true"></i>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="field-error"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control form-control-lg" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Save new password</button>
</form>

<div class="auth-links">
    @if (Model.IsForced)
    {
        <form asp-action="Logout" method="post" class="d-inline">
            <button type="submit" class="btn btn-link p-0">Sign out</button>
        </form>
    }
    else
    {
        <a asp-controller="Home" asp-action="Index">Cancel</a>
    }
</div>
