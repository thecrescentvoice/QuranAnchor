@model ForgotPasswordViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}

<h1 class="auth-title">Forgot your password?</h1>
<p class="auth-sub">Enter your Student ID or email. If we find an account, we will email a link to choose a new password. For students, the email goes to the parent.</p>

<form asp-action="ForgotPassword" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="mb-4">
        <label asp-for="Identifier" class="form-label"></label>
        <input asp-for="Identifier" class="form-control form-control-lg" autocomplete="username" autocapitalize="off" spellcheck="false" autofocus />
        <span asp-validation-for="Identifier" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-lg w-100">Send reset link</button>
</form>

<div class="auth-links">
    <a asp-action="Login">Back to sign in</a>
</div>
