@model PageInfo
@{
    string LinkTo(int page) =>
        Context.Request.Path + QueryString.Create(
            Context.Request.Query.Where(kv => kv.Key != "page")
                .Append(new KeyValuePair<string, Microsoft.Extensions.Primitives.StringValues>("page", page.ToString())));
    var end = Math.Min(Model.TotalPages, Math.Max(1, Model.Page - 2) + 4);
    var start = Math.Max(1, end - 4);
}
@if (Model.Total > 0)
{
    <div class="pager-wrap no-print">
        <span class="muted small">Showing @Model.From–@Model.To of @Model.Total</span>
        @if (Model.TotalPages > 1)
        {
            <nav class="pager" aria-label="Pages">
                <a class="pg @(Model.Page == 1 ? "disabled" : "")" href="@LinkTo(Math.Max(1, Model.Page - 1))" aria-label="Previous page"><i class="bi bi-chevron-left"></i></a>
                @if (start > 1)
                {
                    <a class="pg" href="@LinkTo(1)">1</a>
                    @if (start > 2)
                    {
                        <span class="pg gap">…</span>
                    }
                }
                @for (var p = start; p <= end; p++)
                {
                    <a class="pg @(p == Model.Page ? "current" : "")" href="@LinkTo(p)">@p</a>
                }
                @if (end < Model.TotalPages)
                {
                    @if (end < Model.TotalPages - 1)
                    {
                        <span class="pg gap">…</span>
                    }
                    <a class="pg" href="@LinkTo(Model.TotalPages)">@Model.TotalPages</a>
                }
                <a class="pg @(Model.Page == Model.TotalPages ? "disabled" : "")" href="@LinkTo(Math.Min(Model.TotalPages, Model.Page + 1))" aria-label="Next page"><i class="bi bi-chevron-right"></i></a>
            </nav>
        }
    </div>
}
