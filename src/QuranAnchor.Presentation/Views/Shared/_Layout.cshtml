@using QuranAnchor.Application.Security
@inject QuranAnchor.Application.Abstractions.ISettingsService Settings
@{
    var b = await Settings.GetBrandingAsync();
    var signedIn = User.Identity?.IsAuthenticated == true;
    var role = Roles.All.FirstOrDefault(User.IsInRole) ?? "";
    bool Can(string permission) => signedIn && RolePermissions.Has(role, permission);
    var fullName = User.FindFirst(AppClaimTypes.FullName)?.Value ?? User.Identity?.Name ?? "";
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(params string[] names) => names.Contains(ctrl) ? "active" : "";
    var setupPending = signedIn && (User.HasClaim(AppClaimTypes.MustChangePassword, "1") || User.HasClaim(AppClaimTypes.TwoFactorRequired, "1") || User.HasClaim(AppClaimTypes.ConsentRequired, "1"));
    var today = TimeHelper.ToLocal(DateTime.UtcNow, "Africa/Lagos");
    var hijri = Fmt.Hijri(today, out var hijriMonth);
    var isStaff = role is Roles.SuperAdmin or Roles.Admin or Roles.Supervisor;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <partial name="_Head" model="b" />
</head>
<body class="app-body">
@if (!signedIn || setupPending)
{
    <main class="container py-4">@RenderBody()</main>
}
else
{
    <div class="app-shell">
        <div class="sidebar-overlay" data-nav-close></div>
        <aside class="sidebar" id="sidebar" aria-label="Main menu">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                @if (!string.IsNullOrEmpty(b.LogoPath)) { <img src="@b.LogoPath" alt="" class="brand-logo" /> }
                else { <span class="mark">@b.IdPrefix<span class="dot">.</span></span> }
                <span class="brand-name">@b.AcademyName</span>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-group">
                    <a class="nav-item @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i><span>Dashboard</span></a>
                    <a class="nav-item @Active("Help")" asp-controller="Help" asp-action="Index"><i class="bi bi-question-circle"></i><span>How to use</span></a>
                </div>

                @if (role == Roles.Student)
                {
                    <div class="nav-group"><h6>Learning</h6>
                        <a class="nav-item @Active("Sessions")" asp-controller="Sessions" asp-action="Index"><i class="bi bi-calendar3"></i><span>Classes</span></a>
                        <a class="nav-item @Active("Plans")" asp-controller="Plans" asp-action="Index"><i class="bi bi-journal-text"></i><span>Monthly plans</span></a>
                        <a class="nav-item @Active("Reports")" asp-controller="Reports" asp-action="Mine"><i class="bi bi-graph-up-arrow"></i><span>Reports</span></a>
                        <a class="nav-item @Active("Progress")" asp-controller="Progress" asp-action="Mine"><i class="bi bi-bar-chart-line"></i><span>Progress</span></a>
                        <a class="nav-item @Active("Certificates")" asp-controller="Certificates" asp-action="Index"><i class="bi bi-award"></i><span>Certificates</span></a>
                    </div>
                    <div class="nav-group"><h6>Account</h6>
                        <a class="nav-item @Active("Payments")" asp-controller="Payments" asp-action="Index"><i class="bi bi-credit-card"></i><span>Portal fee</span></a>
                        <a class="nav-item @Active("Invoices")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i><span>Class fees</span></a>
                        <a class="nav-item @Active("Ratings")" asp-controller="Ratings" asp-action="Rate"><i class="bi bi-star"></i><span>Rate my tutor</span></a>
                        <a class="nav-item @Active("Announcements")" asp-controller="Announcements" asp-action="Index"><i class="bi bi-megaphone"></i><span>Announcements</span></a>
                    </div>
                }
                else if (role == Roles.Tutor)
                {
                    <div class="nav-group"><h6>Teaching</h6>
                        <a class="nav-item @Active("Sessions")" asp-controller="Sessions" asp-action="Index"><i class="bi bi-calendar3"></i><span>Classes</span></a>
                        <a class="nav-item @Active("Students")" asp-controller="Students" asp-action="Index"><i class="bi bi-people"></i><span>My students</span></a>
                        <a class="nav-item @Active("Plans")" asp-controller="Plans" asp-action="Index"><i class="bi bi-journal-text"></i><span>Monthly plans</span></a>
                        <a class="nav-item @Active("Certificates")" asp-controller="Certificates" asp-action="Index"><i class="bi bi-award"></i><span>Certificates</span></a>
                    </div>
                    <div class="nav-group"><h6>Me</h6>
                        <a class="nav-item @Active("Meetings")" asp-controller="Meetings" asp-action="Index"><i class="bi bi-camera-video"></i><span>Meetings</span></a>
                        <a class="nav-item @Active("Performance")" asp-controller="Performance" asp-action="Mine"><i class="bi bi-speedometer2"></i><span>My performance</span></a>
                        <a class="nav-item @Active("Availability")" asp-controller="Availability" asp-action="Mine"><i class="bi bi-clock"></i><span>My availability</span></a>
                        <a class="nav-item @Active("Earnings")" asp-controller="Earnings" asp-action="Mine"><i class="bi bi-cash-coin"></i><span>Earnings</span></a>
                        <a class="nav-item @Active("Announcements")" asp-controller="Announcements" asp-action="Index"><i class="bi bi-megaphone"></i><span>Announcements</span></a>
                    </div>
                }
                else
                {
                    <div class="nav-group"><h6>People</h6>
                        <a class="nav-item @Active("Students")" asp-controller="Students" asp-action="Index"><i class="bi bi-people"></i><span>Students</span></a>
                        <a class="nav-item @Active("Tutors")" asp-controller="Tutors" asp-action="Index"><i class="bi bi-person-workspace"></i><span>Tutors</span></a>
                        @if (Can(Permissions.ManageEnquiries)) { <a class="nav-item @Active("Enquiries")" asp-controller="Enquiries" asp-action="Index"><i class="bi bi-inbox"></i><span>Enquiries</span></a> }
                        @if (Can(Permissions.AssignSupervisor)) { <a class="nav-item @Active("Supervisors")" asp-controller="Supervisors" asp-action="Index"><i class="bi bi-diagram-3"></i><span>Supervisors</span></a> }
                        @if (Can(Permissions.ManageStaff)) { <a class="nav-item @Active("Staff")" asp-controller="Staff" asp-action="Index"><i class="bi bi-shield-check"></i><span>Staff</span></a> }
                    </div>
                    <div class="nav-group"><h6>Teaching</h6>
                        <a class="nav-item @Active("Sessions")" asp-controller="Sessions" asp-action="Index"><i class="bi bi-calendar3"></i><span>Classes</span></a>
                        <a class="nav-item @Active("Plans")" asp-controller="Plans" asp-action="Index"><i class="bi bi-journal-text"></i><span>Monthly plans</span></a>
                        <a class="nav-item @Active("Certificates")" asp-controller="Certificates" asp-action="Index"><i class="bi bi-award"></i><span>Certificates</span></a>
                        @if (Can(Permissions.ManageSchedules)) { <a class="nav-item @Active("Availability")" asp-controller="Availability" asp-action="Index"><i class="bi bi-clock"></i><span>Tutor availability</span></a> }
                        @if (Can(Permissions.ViewRatings)) { <a class="nav-item @Active("Ratings")" asp-controller="Ratings" asp-action="Index"><i class="bi bi-star"></i><span>Tutor ratings</span></a> }
                        @if (Can(Permissions.ManageMeetings)) { <a class="nav-item @Active("Meetings")" asp-controller="Meetings" asp-action="Index"><i class="bi bi-camera-video"></i><span>Tutor meetings</span></a> }
                        @if (Can(Permissions.ManageBreakDays)) { <a class="nav-item @Active("BreakDays")" asp-controller="BreakDays" asp-action="Index"><i class="bi bi-calendar-x"></i><span>Break days</span></a> }
                        @if (Can(Permissions.PostAnnouncements)) { <a class="nav-item @Active("Announcements")" asp-controller="Announcements" asp-action="Index"><i class="bi bi-megaphone"></i><span>Announcements</span></a> }
                    </div>
                    <div class="nav-group"><h6>Money</h6>
                        @if (Can(Permissions.ViewPayments)) { <a class="nav-item @Active("Payments")" asp-controller="Payments" asp-action="All"><i class="bi bi-credit-card"></i><span>Payments</span></a> }
                        @if (Can(Permissions.ManageInvoices)) { <a class="nav-item @Active("Invoices")" asp-controller="Invoices" asp-action="Index"><i class="bi bi-receipt"></i><span>Class fees</span></a> }
                        @if (Can(Permissions.ViewAllEarnings)) { <a class="nav-item @Active("Earnings")" asp-controller="Earnings" asp-action="Summary"><i class="bi bi-cash-coin"></i><span>Tutor summary</span></a> }
                        @if (Can(Permissions.ExportData)) { <a class="nav-item @Active("Exports")" asp-controller="Exports" asp-action="Index"><i class="bi bi-file-earmark-excel"></i><span>Excel exports</span></a> }
                        @if (Can(Permissions.EditPricing)) { <a class="nav-item @Active("Pricing")" asp-controller="Pricing" asp-action="Index"><i class="bi bi-tags"></i><span>Pricing</span></a> }
                    </div>
                    @if (Can(Permissions.EditSystemSettings) || Can(Permissions.EditBranding) || Can(Permissions.ViewAuditLog))
                    {
                        <div class="nav-group"><h6>System</h6>
                            @if (Can(Permissions.EditSystemSettings)) { <a class="nav-item @Active("Rules")" asp-controller="Rules" asp-action="Index"><i class="bi bi-sliders"></i><span>Rules</span></a> }
                            @if (Can(Permissions.EditBranding)) { <a class="nav-item @Active("Settings")" asp-controller="Settings" asp-action="Branding"><i class="bi bi-palette"></i><span>Branding</span></a> }
                            @if (Can(Permissions.ViewAuditLog)) { <a class="nav-item @Active("AuditLog")" asp-controller="AuditLog" asp-action="Index"><i class="bi bi-clipboard-data"></i><span>Audit log</span></a> }
                        </div>
                    }
                }
            </nav>

            <div class="sidebar-foot">
                <div class="user-chip">
                    <span class="avatar">@Fmt.Initials(fullName)</span>
                    <span class="user-meta"><strong>@fullName</strong><small>@Roles.DisplayName(role)</small></span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-item w-100 border-0 bg-transparent"><i class="bi bi-box-arrow-right"></i><span>Sign out</span></button></form>
            </div>
        </aside>

        <div class="app-main-wrap">
            <header class="topbar">
                <button class="icon-btn d-lg-none" type="button" data-nav-open aria-label="Open the menu"><i class="bi bi-list"></i></button>
                <div class="topbar-title">@ViewData["Title"]</div>
                @if (isStaff || role == Roles.Tutor)
                {
                    <form asp-controller="Students" asp-action="Index" method="get" class="topbar-search d-none d-md-flex" role="search">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input type="search" name="q" placeholder="Search students" aria-label="Search students" />
                    </form>
                }
                <div class="topbar-date d-none d-sm-flex">
                    @if (hijriMonth == 9) { <span class="chip chip-ramadan">Ramadan Mubarak</span> }
                    <span><strong>@today.ToString("ddd d MMM")</strong><small>@hijri</small></span>
                </div>
                <a class="icon-btn" asp-controller="Account" asp-action="ChangePassword" title="Change password" aria-label="Change password"><i class="bi bi-key"></i></a>
            </header>

            <main class="content">
                @if (TempData["Saved"] is string saved) { <div class="alert alert-success flash" role="status"><i class="bi bi-check-circle-fill"></i><span>@saved</span></div> }
                @if (TempData["Warning"] is string warning) { <div class="alert alert-warning flash" role="alert"><i class="bi bi-exclamation-triangle-fill"></i><span>@warning</span></div> }
                @RenderBody()
                <footer class="app-footer"><span>&copy; @DateTime.UtcNow.Year @b.AcademyName</span></footer>
            </main>
        </div>
    </div>
}

    <div class="modal fade" id="flyerModal" tabindex="-1" aria-labelledby="flyerTitle" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header"><h5 class="modal-title" id="flyerTitle">Flyer</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body text-center"><img id="flyerImg" class="img-fluid" alt="" /></div>
                <div class="modal-footer"><a id="flyerDownload" class="btn btn-primary" href="#" download><i class="bi bi-download" aria-hidden="true"></i> Download</a></div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
