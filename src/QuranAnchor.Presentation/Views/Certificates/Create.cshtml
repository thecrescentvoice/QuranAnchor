@inject QuranAnchor.Presentation.Services.CurrentUser Me
@{
    ViewData["Title"] = "Issue a certificate";
    var students = (List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Students;
    Guid? selected = ViewBag.StudentId;
}
<header class="page-head"><h1>Issue a certificate</h1><p class="page-sub">The parent is emailed, and can see and download it in the portal.</p></header>
<form asp-action="Create" method="post">
    <div class="form-grid section">
        <div><label class="form-label" for="studentId">Student</label>
            <select name="studentId" id="studentId" class="form-select" required>
                <option value="">Choose a student</option>
                @foreach (var s in students) { <option value="@s.Value" selected="@(selected?.ToString() == s.Value)">@s.Text</option> }
            </select></div>
        <div><label class="form-label" for="title">Awarded for</label>
            <input name="title" id="title" class="form-control" list="titles" placeholder="For example Completion of Noorani Qaida" required />
            <datalist id="titles">
                <option value="Completion of Noorani Qaida" /><option value="Completion of the Tajweed course" /><option value="Memorization of Juz Amma" />
                <option value="Memorization of a surah" /><option value="Excellent progress this month" /><option value="Perfect attendance" />
            </datalist></div>
        <div><label class="form-label" for="issuedOn">Date</label><input type="date" name="issuedOn" id="issuedOn" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" class="form-control" required /></div>
    </div>
    <div class="mb-4"><label class="form-label" for="description">A short note (optional)</label><textarea name="description" id="description" class="form-control" rows="3" maxlength="1000" placeholder="For example: recited Surah Al-Mulk from memory with correct tajweed."></textarea></div>
    <button class="btn btn-primary btn-lg" type="submit">Issue certificate</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
