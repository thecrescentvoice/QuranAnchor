@model List<Certificate>
@inject QuranAnchor.Presentation.Services.CurrentUser Me
@{ ViewData["Title"] = "Certificates"; }
<header class="page-head d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div><h1>Certificates</h1><p class="page-sub">Awards for finished courses, memorized surahs and great progress.</p></div>
    @if (Me.Can(Permissions.IssueCertificates)) { <a class="btn btn-primary" asp-action="Create"><i class="bi bi-award" aria-hidden="true"></i> Issue a certificate</a> }
</header>

@if (Model.Count == 0)
{
    <p class="empty-note"><i class="bi bi-award" aria-hidden="true"></i> No certificates yet.</p>
}
else
{
    <div class="cert-grid">
        @foreach (var c in Model)
        {
            <a class="cert-card @(c.IsRevoked ? "revoked" : "")" asp-action="Show" asp-route-id="@c.Id">
                <span class="cert-ribbon"><i class="bi bi-award-fill" aria-hidden="true"></i></span>
                <span class="small-label">@c.IssuedOn.ToString("d MMM yyyy")</span>
                <strong>@c.Title</strong>
                <span class="muted">@c.Student?.FullName</span>
                @if (c.IsRevoked) { <span class="badge-status s-nothel">Withdrawn</span> }
            </a>
        }
    </div>
}

<partial name="_Pager" model="(PageInfo)ViewBag.PageInfo" />
