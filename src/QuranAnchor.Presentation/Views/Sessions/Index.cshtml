@model List<ClassSession>
@inject QuranAnchor.Presentation.Services.CurrentUser Me
@{
    ViewData["Title"] = "Classes";
    var zone = (string)ViewBag.Zone;
    DateOnly start = ViewBag.From;
    int days = ViewBag.Days;
    var groups = Model.GroupBy(s => TimeHelper.ToLocal(s.StartUtc, Me.IsStaff ? (s.Student?.TimeZoneId ?? zone) : zone).Date).OrderBy(g => g.Key);
}
<header class="page-head"><h1>Classes</h1><p class="page-sub">@start.ToString("d MMM") to @start.AddDays(days - 1).ToString("d MMM yyyy") · times in @TimeHelper.City(zone) time</p></header>

<form method="get" class="d-flex flex-wrap gap-2 mb-3">
    <input type="date" name="from" value="@start.ToString("yyyy-MM-dd")" class="form-control" style="max-width:12rem" />
    <select name="days" class="form-select" style="max-width:9rem">
        @foreach (var d in new[] { 7, 14, 30, 60 }) { <option value="@d" selected="@(d == days)">@d days</option> }
    </select>
    <button class="btn btn-outline-secondary" type="submit">Show</button>
    <a class="btn btn-link" asp-route-from="@(start.AddDays(-days).ToString("yyyy-MM-dd"))" asp-route-days="@days">Earlier</a>
    <a class="btn btn-link" asp-route-from="@(start.AddDays(days).ToString("yyyy-MM-dd"))" asp-route-days="@days">Later</a>
</form>

@if (Model.Count == 0) { <p class="empty-note">No classes in this period.</p> }
@foreach (var g in groups)
{
    <section class="section">
        <h2>@g.Key.ToString("dddd d MMMM")</h2>
        <div class="panel"><ul class="list-plain">
            @foreach (var s in g)
            {
                var tz = Me.IsStaff ? (s.Student?.TimeZoneId ?? zone) : zone;
                <li>
                    <span><strong>@Fmt.Time(s.StartUtc, tz)</strong> · @s.DurationMinutes min · @(Me.IsStudent ? s.Tutor?.FullName : s.Student?.FullName)@(Me.IsStaff ? " with " + s.Tutor?.FullName : "")@(s.IsExtra ? " · extra" : "")</span>
                    <span><span class="badge-status s-@s.Status.ToString().ToLower()">@s.Status</span> <a asp-action="Details" asp-route-id="@s.Id">Open</a></span>
                </li>
            }
        </ul></div>
    </section>
}
