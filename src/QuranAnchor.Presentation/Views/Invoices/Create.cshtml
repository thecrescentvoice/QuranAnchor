@{
    ViewData["Title"] = "New invoice";
    var students = (List<StudentProfile>)ViewBag.Students;
    Guid? selected = ViewBag.StudentId;
}
<header class="page-head"><h1>New invoice</h1><p class="page-sub">The parent is emailed the amount, the due date and how to pay.</p></header>
<form asp-action="Create" method="post">
    <div class="form-grid section">
        <div><label class="form-label" for="studentId">Student</label>
            <select name="studentId" id="studentId" class="form-select" required>
                <option value="">Choose a student</option>
                @foreach (var s in students) { <option value="@s.Id" data-fee="@s.ClassFeeAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" data-cur="@s.ClassFeeCurrency" selected="@(selected == s.Id)">@s.FullName (@s.StudentCode)</option> }
            </select></div>
        <div><label class="form-label" for="period">Month</label><input type="month" id="period" name="period" value="@DateTime.UtcNow.ToString("yyyy-MM")" class="form-control" required /></div>
        <div><label class="form-label" for="amount">Amount</label><input type="number" step="0.01" min="0.01" id="amount" name="amount" class="form-control" required /></div>
        <div><label class="form-label" for="currency">Currency</label><select id="currency" name="currency" class="form-select"><option value="NGN">NGN (naira)</option><option value="USD">USD (dollars)</option><option value="GBP">GBP (pounds)</option></select></div>
        <div><label class="form-label" for="dueDate">Due date</label><input type="date" id="dueDate" name="dueDate" value="@DateTime.UtcNow.AddDays(7).ToString("yyyy-MM-dd")" class="form-control" required /></div>
    </div>
    <div class="mb-4"><label class="form-label" for="description">Description (optional)</label><input id="description" name="description" class="form-control" placeholder="Class fee for the month" /></div>
    <button class="btn btn-primary btn-lg" type="submit">Create invoice</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
@section Scripts {
    <script>
        document.getElementById('studentId').addEventListener('change', function () {
            var option = this.options[this.selectedIndex];
            var fee = option.getAttribute('data-fee');
            if (fee && parseFloat(fee) > 0) { document.getElementById('amount').value = fee; document.getElementById('currency').value = option.getAttribute('data-cur') || 'NGN'; }
        });
    </script>
}
