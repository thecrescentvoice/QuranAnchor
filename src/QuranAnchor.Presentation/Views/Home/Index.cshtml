@model DashboardData
@inject QuranAnchor.Application.Abstractions.ISettingsService Settings
@{
    ViewData["Title"] = "Dashboard";
    var b = await Settings.GetBrandingAsync();
    var tz = Model.Zone;
    string Help(string category) => Fmt.WhatsApp(b, $"Assalamu alaikum, I would like to report an issue about {Model.Student?.FullName} ({Model.Student?.StudentCode}). Category: {category}.");
}

<section class="hero">
    <p class="hero-ar" dir="rtl">بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ</p>
    <h1>Assalamu alaikum, @Model.FullName</h1>
    <p>
        <span class="chip">@Model.RoleName</span>
        @if (Model.Role == Roles.Student && Model.Student is not null)
        {
            <span class="chip">@Model.Student.Level</span>
            if (Model.Student.Tutor is not null)
            {
                <span>with @Model.Student.Tutor.FullName</span>
            }
        }
        @if (Model.Role == Roles.Tutor) { <span>@(Model.Today.Count == 0 ? "No classes today." : $"{Model.Today.Count} class(es) today.")</span> }
        @if (Model.Role != Roles.Student && Model.Role != Roles.Tutor) { <span>Here is how the academy is doing.</span> }
    </p>
</section>

@if (Model.Announcements.Count > 0)
{
    <section class="section">
        <h2>Announcements</h2>
        <div class="panel">
            <ul class="list-plain">
                @foreach (var a in Model.Announcements)
                {
                    <li class="d-block">
                        <div class="d-flex justify-content-between gap-2"><strong>@a.Title</strong><span class="muted small">@a.CreatedAtUtc.ToString("d MMM")</span></div>
                        <div class="muted" style="white-space:pre-line">@Fmt.Linkify(a.Body)</div>
                        @if (Fmt.VideoLink(a.Body) is { } video)
                        {
                            <a class="btn btn-outline-secondary btn-sm mt-1" href="@video" target="_blank" rel="noopener noreferrer"><i class="bi bi-play-circle" aria-hidden="true"></i> Watch the video</a>
                        }
                        <partial name="~/Views/Announcements/_FlyerBlock.cshtml" model="a" />
                    </li>
                }
            </ul>
        </div>
    </section>
}

@if (Model.Role == Roles.Student)
{
    if (Model.Student is null)
    {
        <p class="empty-note"><i class="bi bi-person-x"></i> Your student profile was not found. Please contact the supervisor.</p>
    }
    else
    {
        if (Model.Fee == FeeState.Overdue)
        {
            <div class="banner banner-warn"><strong>The portal fee is overdue.</strong> Please pay soon to keep the monthly plan available. <a asp-controller="Payments" asp-action="Index">Pay now</a></div>
        }
        else if (Model.Fee == FeeState.Locked)
        {
            <div class="banner banner-lock"><strong>The monthly plan is locked</strong> until the portal fee is paid. Your classes and Join button are not affected. <a asp-controller="Payments" asp-action="Index">Pay now</a></div>
        }

        if (Model.JoinNow is not null)
        {
            <div class="join-card">
                <div class="small-label" style="color:#1F2A2C">Class now</div>
                <h2 class="h4 mb-3" style="text-transform:none;letter-spacing:0;color:inherit">@Fmt.Time(Model.JoinNow.StartUtc, tz) · @Model.JoinNow.DurationMinutes minutes</h2>
                <a class="btn btn-lg" asp-controller="Sessions" asp-action="Join" asp-route-id="@Model.JoinNow.Id"><i class="bi bi-camera-video" aria-hidden="true"></i> Join class</a>
            </div>
        }

        <div class="row g-3 section">
            <div class="col-md-4">
                <div class="stat"><span class="stat-icon"><i class="bi bi-calendar-check"></i></span>
                    <div class="flex-grow-1">
                        <div class="small-label">Sessions this month</div>
                        @if (Model.Usage is not null)
                        {
                            var pct = Model.Usage.Total == 0 ? 0 : Math.Min(100, Model.Usage.Used * 100 / Model.Usage.Total);
                            <div class="stat-value">@Model.Usage.Used / @Model.Usage.Total</div>
                            <div class="meter mt-1" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"><span style="width:@(pct)%"></span></div>
                        }
                        else { <div class="stat-sub">Not set up yet</div> }
                    </div></div>
            </div>
            <div class="col-md-4">
                <div class="stat"><span class="stat-icon tone-cyan"><i class="bi bi-clock-history"></i></span>
                    <div>
                        <div class="small-label">Next class</div>
                        @if (Model.Upcoming.FirstOrDefault(u => u.StartUtc > DateTime.UtcNow) is { } next)
                        {
                            <div class="stat-value">@Fmt.Day(next.StartUtc, tz)</div><div class="stat-sub">@Fmt.Time(next.StartUtc, tz)</div>
                        }
                        else { <div class="stat-sub">None scheduled</div> }
                    </div></div>
            </div>
            <div class="col-md-4">
                <div class="stat"><span class="stat-icon @(Model.Fee is FeeState.Paid or FeeState.Exempt ? "tone-green" : "tone-amber")"><i class="bi bi-credit-card"></i></span>
                    <div>
                        <div class="small-label">Portal fee</div>
                        <div class="stat-value">@(Model.Fee switch { FeeState.Paid => "Paid", FeeState.Exempt => "Not required", FeeState.Overdue => "Overdue", _ => "Locked" })</div>
                        <div class="stat-sub">@(Model.Student.PaidUntilUtc is { } until ? $"until {until:d MMM yyyy}" : "") <a asp-controller="Payments" asp-action="Index">Details</a></div>
                    </div></div>
            </div>
        </div>

        <section class="section">
            <h2>Upcoming classes</h2>
            <div class="panel">
                @if (Model.Upcoming.Count == 0) { <p class="muted mb-0">No upcoming classes.</p> }
                else
                {
                    <ul class="list-plain">
                        @foreach (var s in Model.Upcoming)
                        {
                            <li><a asp-controller="Sessions" asp-action="Details" asp-route-id="@s.Id">@Fmt.Local(s.StartUtc, tz)</a><span class="muted">@s.DurationMinutes min</span></li>
                        }
                    </ul>
                }
            </div>
        </section>

        <section class="section">
            <h2>This month's rating</h2>
            <div class="panel d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="muted">How are the classes going? Rate your tutor once a month.</span>
                <a class="btn btn-outline-secondary" asp-controller="Ratings" asp-action="Rate"><i class="bi bi-star" aria-hidden="true"></i> Rate my tutor</a>
            </div>
        </section>

        @if (!string.IsNullOrEmpty(b.SupervisorWhatsApp))
        {
            <section class="section">
                <h2>Report an issue</h2>
                <div class="panel">
                    <p class="muted">This opens WhatsApp with a message already written. You can edit it before you send.</p>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var category in new[] { "Class problem", "Concern about the tutor", "Payment", "Technical problem", "Other" })
                        {
                            <a class="btn btn-outline-secondary" href="@Help(category)" target="_blank" rel="noopener">@category</a>
                        }
                    </div>
                </div>
            </section>
        }
    }
}
else if (Model.Role == Roles.Tutor)
{
    <div class="row g-3 section">
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon tone-green"><i class="bi bi-cash-coin"></i></span><div><div class="small-label">Earned this month</div><div class="stat-value">@Model.MonthAmount.ToString("₦#,##0")</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon"><i class="bi bi-check2-circle"></i></span><div><div class="small-label">Classes held</div><div class="stat-value">@Model.MonthHeld</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon tone-cyan"><i class="bi bi-calendar-day"></i></span><div><div class="small-label">Today</div><div class="stat-value">@Model.Today.Count</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon tone-amber"><i class="bi bi-pencil-square"></i></span><div><div class="small-label">Feedback waiting</div><div class="stat-value">@Model.NeedFeedback.Count</div></div></div></div>
    </div>

    @if (Model.RequestsForMe.Count > 0)
    {
        <section class="section">
            <h2>Class change requests</h2>
            <div class="panel"><ul class="list-plain">
                @foreach (var r in Model.RequestsForMe)
                {
                    <li><span>@r.Session?.Student?.FullName asks to move a class to <strong>@Fmt.Local(r.ProposedStartUtc, tz)</strong></span><a asp-controller="Sessions" asp-action="Details" asp-route-id="@r.SessionId">Answer</a></li>
                }
            </ul></div>
        </section>
    }

    @if (Model.Meetings.Count > 0)
    {
        <section class="section">
            <h2>Upcoming meetings</h2>
            <div class="panel"><ul class="list-plain">
                @foreach (var m in Model.Meetings)
                {
                    <li><span><strong>@m.Title</strong> · @Fmt.Local(m.StartUtc, tz)</span>
                        <span class="d-flex gap-2 align-items-center">
                            <a asp-controller="Meetings" asp-action="Details" asp-route-id="@m.Id">Details</a>
                            @if (!string.IsNullOrEmpty(m.MeetingLink)) { <a class="btn btn-primary btn-sm" href="@m.MeetingLink" target="_blank" rel="noopener">Join</a> }
                        </span></li>
                }
            </ul></div>
        </section>
    }

    <section class="section">
        <h2>Today's classes</h2>
        <div class="panel">
            @if (Model.Today.Count == 0) { <p class="muted mb-0">No classes today.</p> }
            else
            {
                <ul class="list-plain">
                    @foreach (var s in Model.Today)
                    {
                        <li><span><strong>@Fmt.Time(s.StartUtc, tz)</strong> · @s.Student?.FullName · @s.DurationMinutes min</span><a asp-controller="Sessions" asp-action="Details" asp-route-id="@s.Id">Open</a></li>
                    }
                </ul>
            }
        </div>
    </section>

    @if (Model.NeedFeedback.Count > 0)
    {
        <section class="section">
            <h2>Write feedback</h2>
            <div class="panel"><ul class="list-plain">
                @foreach (var s in Model.NeedFeedback)
                {
                    <li><span>@Fmt.Local(s.StartUtc, tz) · @s.Student?.FullName</span><a asp-controller="Feedback" asp-action="Form" asp-route-sessionId="@s.Id">Write feedback</a></li>
                }
            </ul></div>
        </section>
    }
}
else
{
    <div class="row g-3 section">
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon tone-amber"><i class="bi bi-pencil-square"></i></span><div><div class="small-label">No feedback</div><div class="stat-value">@Model.MissingFeedback.Count</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon"><i class="bi bi-hourglass-split"></i></span><div><div class="small-label">Packages ending</div><div class="stat-value">@Model.Ending.Count</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon tone-cyan"><i class="bi bi-arrow-left-right"></i></span><div><div class="small-label">Change requests</div><div class="stat-value">@Model.PendingRequests.Count</div></div></div></div>
        <div class="col-6 col-lg-3"><div class="stat"><span class="stat-icon tone-magenta"><i class="bi bi-credit-card-2-front"></i></span><div><div class="small-label">Fee overdue</div><div class="stat-value">@Model.OverdueFees.Count</div></div></div></div>
    </div>

    @if (Model.NewEnquiries > 0)
    {
        <div class="banner banner-warn"><i class="bi bi-inbox" aria-hidden="true"></i> <strong>@Model.NewEnquiries new enquiry(ies)</strong> from families asking about classes. <a asp-controller="Enquiries" asp-action="Index">Open the list</a></div>
    }

    <section class="section">
        <h2>Classes with no feedback</h2>
        <div class="panel">
            @if (Model.MissingFeedback.Count == 0) { <p class="muted mb-0">Nothing missing.</p> }
            else
            {
                <ul class="list-plain">
                    @foreach (var s in Model.MissingFeedback)
                    {
                        <li><span>@Fmt.Local(s.StartUtc, s.Student?.TimeZoneId ?? tz) · @s.Student?.FullName · @s.Tutor?.FullName</span><a asp-controller="Sessions" asp-action="Details" asp-route-id="@s.Id">Open</a></li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="section">
        <h2>Packages nearly used up, or sessions still unscheduled</h2>
        <div class="panel">
            @if (Model.Ending.Count == 0) { <p class="muted mb-0">Nothing to do.</p> }
            else
            {
                <ul class="list-plain">
                    @foreach (var e in Model.Ending)
                    {
                        <li><a asp-controller="Students" asp-action="Details" asp-route-id="@e.Student.Id">@e.Student.FullName</a><span class="muted">@e.Usage.Used of @e.Usage.Total used · @e.Usage.Unscheduled not yet scheduled</span></li>
                    }
                </ul>
            }
        </div>
    </section>

    @if (Model.PendingRequests.Count > 0)
    {
        <section class="section">
            <h2>Pending class change requests</h2>
            <div class="panel"><ul class="list-plain">
                @foreach (var r in Model.PendingRequests)
                {
                    <li><span>@r.Session?.Student?.FullName · to @Fmt.Local(r.ProposedStartUtc, r.Session?.Student?.TimeZoneId ?? tz)</span><a asp-controller="Sessions" asp-action="Details" asp-route-id="@r.SessionId">Open</a></li>
                }
            </ul></div>
        </section>
    }

    @if (Model.OverdueFees.Count > 0)
    {
        <section class="section">
            <h2>Portal fee overdue</h2>
            <div class="panel"><ul class="list-plain">
                @foreach (var s in Model.OverdueFees)
                {
                    <li><a asp-controller="Students" asp-action="Details" asp-route-id="@s.Id">@s.FullName</a><span class="muted">paid until @(s.PaidUntilUtc?.ToString("d MMM") ?? "never")</span></li>
                }
            </ul></div>
        </section>
    }
}
