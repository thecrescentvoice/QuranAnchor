@model MonthlyPlan
@inject QuranAnchor.Presentation.Services.CurrentUser Me
@{
    ViewData["Title"] = "Monthly plan";
    string[] Lines(string text) => (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    var tracks = new[] { (PlanTrack.Hifz, "Hifz goal"), (PlanTrack.Qiraah, "Qira’ah goal"), (PlanTrack.Murajaah, "Murāja’ah goal"), (PlanTrack.Tajweed, "Tajweed goal") };
    string Goal(int week, PlanTrack track) => Model.Goals.FirstOrDefault(g => g.Week == week && g.Track == track)?.Text ?? "Not Applicable";
}
<header class="page-head">
    <h1>Monthly plan: @Fmt.Month(Model.Year, Model.Month)</h1>
    <p class="page-sub">@Model.Student?.FullName · Tutor: @Model.Tutor?.FullName · <span class="badge-status s-@Model.Status.ToString().ToLower()">@Model.Status</span></p>
</header>

<div class="d-flex flex-wrap gap-2 section no-print">
    <a class="btn btn-primary" asp-action="Pdf" asp-route-id="@Model.Id"><i class="bi bi-download" aria-hidden="true"></i> Download PDF</a>
    @if (!Me.IsStudent) { <a class="btn btn-outline-secondary" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-studentId="@Model.StudentId">Edit in the grid</a> }
    @if (!Me.IsStudent && Model.Status == PublishStatus.Draft) { <form asp-action="Publish" asp-route-id="@Model.Id" method="post"><button class="btn btn-outline-secondary">Publish</button></form> }
</div>

<section class="section"><h2>After each class</h2><div class="panel"><ol class="mb-0">@foreach (var l in Lines(Model.PostClassExpectations)) { <li>@l</li> }</ol></div></section>

<section class="section"><h2>Month goal</h2>
    <div class="table-card table-responsive"><table class="table text-center align-middle">
        <thead><tr><th>Week</th>@foreach (var (_, label) in tracks) { <th>@label</th> }</tr></thead>
        <tbody>
        @for (var week = 1; week <= 4; week++)
        {
            <tr><th class="text-danger">WEEK @week</th>@foreach (var (track, _) in tracks) { <td class="fw-semibold">@Goal(week, track)</td> }</tr>
        }
        </tbody>
    </table></div>
</section>

@if (Lines(Model.ParentNotes).Length > 0) { <section class="section"><h2>Notes</h2><div class="panel"><ul class="mb-0">@foreach (var l in Lines(Model.ParentNotes)) { <li>@l</li> }</ul></div></section> }
