@model List<MonthlyPlan>
@inject QuranAnchor.Presentation.Services.CurrentUser Me
@{ ViewData["Title"] = "Plans"; }
<header class="page-head"><h1>Monthly plans</h1><p class="page-sub">@(Me.IsStudent ? "Published plans." : "Most recent plans. To write a new one, open the student and choose Write or edit this month's plan.")</p></header>
@if (Model.Count == 0) { <p class="empty-note">No plans yet.</p> }
else
{
    <div class="table-card table-responsive"><table class="table align-middle">
        <thead><tr><th>Month</th><th>Student</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr><td>@Fmt.Month(p.Year, p.Month)</td><td>@p.Student?.FullName</td>
                <td><span class="badge-status s-@p.Status.ToString().ToLower()">@p.Status</span></td>
                <td class="text-end"><a asp-action="Show" asp-route-id="@p.Id">Open</a>@if (!Me.IsStudent) { <text> · </text><a asp-action="Edit" asp-route-studentId="@p.StudentId" asp-route-year="@p.Year" asp-route-month="@p.Month">Edit</a> }</td></tr>
        }
        </tbody>
    </table></div>
}
