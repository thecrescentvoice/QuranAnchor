@model List<Announcement>
@inject QuranAnchor.Presentation.Services.CurrentUser Me
@{ ViewData["Title"] = "Announcements"; }
<header class="page-head d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div><h1>Announcements</h1></div>
    @if (Me.Can(Permissions.PostAnnouncements)) { <a class="btn btn-primary" asp-action="Create">New announcement</a> }
</header>
@if (Model.Count == 0) { <p class="empty-note">No announcements yet.</p> }
@foreach (var a in Model)
{
    <article class="panel section">
        <h2 class="h5 mb-1">@a.Title</h2>
        <p class="muted small mb-2">@a.CreatedAtUtc.ToString("d MMM yyyy") · @a.CreatedBy · for @a.Audience</p>
        <p class="mb-0" style="white-space:pre-line">@a.Body</p>
    </article>
}
