@model Announcement
@if (!string.IsNullOrEmpty(Model.FlyerPath))
{
    <div class="flyer-block">
        @if (Model.FlyerKind == "image")
        {
            <a class="flyer-thumb" href="@Model.FlyerPath" data-flyer-src="@Model.FlyerPath" data-flyer-name="@Model.FlyerName" data-flyer-title="@Model.Title" title="Click to view the flyer">
                <img src="@Model.FlyerPath" alt="Flyer: @Model.Title" loading="lazy" />
                <span class="flyer-zoom"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i> View</span>
            </a>
        }
        else
        {
            <a class="flyer-pdf" href="@Model.FlyerPath" target="_blank" rel="noopener">
                <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
                <span><strong>@Model.FlyerName</strong><small>Open the PDF flyer</small></span>
            </a>
        }
        <a class="btn btn-outline-secondary btn-sm" href="@Model.FlyerPath" download="@Model.FlyerName"><i class="bi bi-download" aria-hidden="true"></i> Download</a>
    </div>
}
