@model AnnouncementFormViewModel
@{ ViewData["Title"] = "Edit announcement"; }
<header class="page-head"><h1>Edit announcement</h1></header>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" novalidate>
    <partial name="_Form" model="Model" />
    <button class="btn btn-primary btn-lg" type="submit">Save changes</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
