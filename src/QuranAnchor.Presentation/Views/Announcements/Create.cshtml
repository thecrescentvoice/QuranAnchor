@model AnnouncementFormViewModel
@{ ViewData["Title"] = "New announcement"; }
<header class="page-head"><h1>New announcement</h1></header>
<form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
    <partial name="_Form" model="Model" />
    <div class="form-check mb-4"><input asp-for="SendEmail" class="form-check-input" /><label asp-for="SendEmail" class="form-check-label"></label></div>
    <button class="btn btn-primary btn-lg" type="submit">Post</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
